---
import { releaseBase, version } from '../data/release';
const githubSvgPath = 'M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z';
const primaryDownloads = {
  macosArm: `${releaseBase}/Presto-${version}-macOS-arm64.dmg`,
  macosIntel: `${releaseBase}/Presto-${version}-macOS-amd64.dmg`,
  windowsX64: `${releaseBase}/Presto-${version}-windows-amd64-installer.exe`,
  windowsArm: `${releaseBase}/Presto-${version}-windows-arm64-installer.exe`,
  linuxX64: `${releaseBase}/Presto-${version}-linux-amd64.tar.gz`,
  linuxArm: `${releaseBase}/Presto-${version}-linux-arm64.tar.gz`,
};
const homebrewInstall = 'brew tap brewforge/chinese && brew install presto';
const alternateDownloads = [
  { key: 'macos-intel', zh: 'macOS Intel', en: 'macOS Intel', url: primaryDownloads.macosIntel },
  { key: 'windows-x64', zh: 'Windows x64', en: 'Windows x64', url: primaryDownloads.windowsX64 },
  { key: 'windows-arm', zh: 'Windows ARM64', en: 'Windows ARM64', url: primaryDownloads.windowsArm },
  { key: 'linux-x64', zh: 'Linux x64', en: 'Linux x64', url: primaryDownloads.linuxX64 },
  { key: 'linux-arm', zh: 'Linux ARM64', en: 'Linux ARM64', url: primaryDownloads.linuxArm },
];
---

<section class="hero">
  <!-- Liquid glass field -->
  <div class="hero-bg" aria-hidden="true">
    <div class="liquid-plane liquid-plane-1"></div>
    <div class="liquid-plane liquid-plane-2"></div>
  </div>

  <div class="container hero-content">
    <div class="hero-badge hero-anim" style="animation-delay: 0s">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      <span class="zh">开源免费 · MIT 协议</span>
      <span class="en">Open Source · MIT License</span>
    </div>

    <div class="hero-copy-grid">
      <h1 class="hero-title hero-anim" style="animation-delay: 0.08s">
        <span class="title-stack zh">
          <span class="title-line">Markdown</span>
          <span class="title-pair"><span class="title-connector">到</span><span class="title-line">PDF</span></span>
          <span class="title-subline gradient-text">专业排版</span>
        </span>
        <span class="title-stack en">
          <span class="title-line">Markdown</span>
          <span class="title-pair"><span class="title-connector">to</span><span class="title-line">PDF</span></span>
          <span class="title-subline gradient-text">Reimagined</span>
        </span>
      </h1>

      <div class="hero-side hero-anim" style="animation-delay: 0.18s">
        <p class="hero-desc">
          <span class="zh">基于 Typst 排版引擎，把写作、模板、预览和导出收进一个清爽的桌面工作台。</span>
          <span class="en">Powered by Typst, Presto brings writing, templates, preview, and export into one focused desktop workspace.</span>
        </p>

        <div class="hero-ctas">
          <a
            href={primaryDownloads.macosArm}
            class="btn btn-primary"
            id="hero-download-link"
            data-macos-arm={primaryDownloads.macosArm}
            data-macos-intel={primaryDownloads.macosIntel}
            data-windows-x64={primaryDownloads.windowsX64}
            data-windows-arm={primaryDownloads.windowsArm}
            data-linux-x64={primaryDownloads.linuxX64}
            data-linux-arm={primaryDownloads.linuxArm}
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            <span class="zh hero-download-label">免费下载</span>
            <span class="en hero-download-label">Download Free</span>
          </a>
          <a href="https://github.com/Presto-io/Presto" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d={githubSvgPath}/></svg>
            GitHub
          </a>
        </div>

        <div class="homebrew-card" id="homebrew-card" aria-hidden="true">
          <div class="homebrew-card-head">
            <span class="zh">推荐：Homebrew 安装</span>
            <span class="en">Recommended: Homebrew</span>
            <button class="copy-btn homebrew-copy" data-copy={homebrewInstall}>
              <span class="zh">复制</span>
              <span class="en">Copy</span>
            </button>
          </div>
          <code>{homebrewInstall}</code>
        </div>

        <p class="alternate-downloads">
          <span class="zh">其他版本：</span>
          <span class="en">Other versions:</span>
          {alternateDownloads.map((item, index) => (
            <span class="alternate-download-item" data-download-key={item.key}>
              {index > 0 && <span class="download-separator">·</span>}
              <a href={item.url} target="_blank" rel="noopener noreferrer">
                <span class="zh">{item.zh}</span>
                <span class="en">{item.en}</span>
              </a>
            </span>
          ))}
        </p>

        <div class="hero-version">
          <span class="zh">最新版本 v{version} · macOS / Windows / Linux</span>
          <span class="en">Latest v{version} · macOS / Windows / Linux</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Hero showcase -->
  <div class="container">
    <div class="hero-image hero-anim adaptive-frame" data-frame-min-width="560" style="animation-delay: 0.4s">
      <iframe
        src="/showcase/hero"
        class="hero-iframe"
        loading="eager"
        title="Presto Editor"
        sandbox="allow-scripts allow-same-origin"
      ></iframe>
    </div>
  </div>

  <div class="container hero-story" aria-label="Presto workflow">
    <div class="story-card story-card--editor animate-on-scroll">
      <div class="story-copy">
        <span class="story-eyebrow">
          <span class="zh">写作台</span>
          <span class="en">Editor</span>
        </span>
        <h2>
          <span class="zh">写得轻，排得准。</span>
          <span class="en">Write light. Typeset clean.</span>
        </h2>
      </div>
      <div class="software-illustration editor-illustration" aria-hidden="true">
        <div class="mini-window-bar"><span></span><span></span><span></span></div>
        <div class="mini-editor-lines">
          <i style="--w: 82%"></i><i style="--w: 46%"></i><i style="--w: 68%"></i><i style="--w: 58%"></i><i style="--w: 76%"></i>
        </div>
        <div class="mini-template-chip">gongwen</div>
      </div>
    </div>

    <div class="story-card story-card--preview animate-on-scroll">
      <div class="story-copy">
        <span class="story-eyebrow">
          <span class="zh">预览</span>
          <span class="en">Preview</span>
        </span>
        <h2>
          <span class="zh">预览像纸面一样即时成形。</span>
          <span class="en">Preview forms like paper in motion.</span>
        </h2>
      </div>
      <div class="software-illustration preview-illustration" aria-hidden="true">
        <div class="paper-page">
          <b></b><i></i><i></i><i></i><i></i>
        </div>
        <div class="paper-shadow"></div>
      </div>
    </div>

    <div class="story-card story-card--store animate-on-scroll">
      <div class="story-copy">
        <span class="story-eyebrow">
          <span class="zh">扩展</span>
          <span class="en">Extend</span>
        </span>
        <h2>
          <span class="zh">模板与技能，进入同一流程。</span>
          <span class="en">Templates and skills share one flow.</span>
        </h2>
      </div>
      <div class="software-illustration store-illustration" aria-hidden="true">
        <div class="store-tile"></div>
        <div class="store-tile"></div>
        <div class="store-tile wide"></div>
        <div class="store-tile"></div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var container = document.querySelector('.hero-image');
  var iframe = container ? container.querySelector('.hero-iframe') : null;
  if (!container || !iframe) return;

  function fitAdaptiveFrame(frame) {
    var frameIframe = frame.querySelector('iframe');
    if (!frameIframe) return;
    var boxWidth = frame.clientWidth;
    var boxHeight = frame.clientHeight;
    if (!boxWidth || !boxHeight) return;

    var minWidth = parseFloat(frame.dataset.frameMinWidth || '560');
    var targetWidth = Math.max(boxWidth, minWidth);

    try {
      var doc = frameIframe.contentDocument;
      var contentWidth = doc ? Math.max(doc.documentElement.scrollWidth, doc.body ? doc.body.scrollWidth : 0) : 0;
      if (contentWidth > targetWidth && boxWidth < contentWidth) {
        targetWidth = contentWidth;
      }
    } catch (error) {
      // Same-origin showcase frames are expected; keep the declared minimum as fallback.
    }

    var scale = Math.min(1, boxWidth / targetWidth);
    frameIframe.style.width = Math.ceil(targetWidth) + 'px';
    frameIframe.style.height = Math.ceil(boxHeight / scale) + 'px';
    frameIframe.style.transform = scale < 0.999 ? 'scale(' + scale.toFixed(4) + ')' : 'none';
  }

  fitAdaptiveFrame(container);
  iframe.addEventListener('load', function () {
    fitAdaptiveFrame(container);
    window.setTimeout(function () { fitAdaptiveFrame(container); }, 250);
  });
  if ('ResizeObserver' in window) {
    var heroFrameObserver = new ResizeObserver(function () {
      fitAdaptiveFrame(container);
    });
    heroFrameObserver.observe(container);
  } else {
    window.addEventListener('resize', function () { fitAdaptiveFrame(container); });
  }

  var heroSide = document.querySelector('.hero-side');
  if (heroSide) {
    var heroTitle = document.querySelector('.hero-title');

    function getTitleRows() {
      if (!heroTitle) return [];

      var titleParts = heroTitle.querySelectorAll('.title-stack > .title-line, .title-stack > .title-pair, .title-stack > .title-subline');
      var rows = [];

      for (var i = 0; i < titleParts.length; i++) {
        var rect = titleParts[i].getBoundingClientRect();
        if (!rect.width || !rect.height) continue;
        rows.push({
          left: rect.left,
          right: rect.right,
          top: rect.top,
          bottom: rect.bottom,
          width: rect.width,
          height: rect.height
        });
      }

      rows.sort(function (a, b) {
        return a.top - b.top;
      });

      return rows;
    }

    function getTitleVisualRect(rows) {
      if (!heroTitle) return null;

      var titleRows = rows || getTitleRows();
      var left = Infinity;
      var right = -Infinity;
      var top = Infinity;
      var bottom = -Infinity;

      for (var i = 0; i < titleRows.length; i++) {
        var rect = titleRows[i];
        left = Math.min(left, rect.left);
        right = Math.max(right, rect.right);
        top = Math.min(top, rect.top);
        bottom = Math.max(bottom, rect.bottom);
      }

      if (!isFinite(left)) return heroTitle.getBoundingClientRect();

      return {
        left: left,
        right: right,
        top: top,
        bottom: bottom,
        width: right - left,
        height: bottom - top
      };
    }

    function tuneHeroSideOffset() {
      if (!heroTitle || window.matchMedia('(max-width: 768px)').matches) {
        if (heroTitle) heroTitle.style.removeProperty('--hero-title-box-width');
        heroSide.style.setProperty('--hero-side-y', '0px');
        return;
      }

      heroSide.style.setProperty('--hero-side-y', '0px');
      var titleRows = getTitleRows();
      var titleRect = getTitleVisualRect(titleRows);
      var titleMaxWidth = Math.max(0, document.documentElement.clientWidth - titleRect.left - 24);
      heroTitle.style.setProperty('--hero-title-box-width', Math.ceil(Math.min(titleRect.width, titleMaxWidth)) + 'px');
      titleRows = getTitleRows();
      titleRect = getTitleVisualRect(titleRows);
      var sideRect = heroSide.getBoundingClientRect();
      var rowGap = Math.min(34, Math.max(22, window.innerWidth * 0.018));
      var sideHeight = sideRect.height;
      var targetTop = titleRows.length ? titleRows[0].top : titleRect.top;

      for (var i = 0; i < titleRows.length; i++) {
        var row = titleRows[i];
        var horizontalOverlap = Math.min(row.right, sideRect.right) - Math.max(row.left, sideRect.left);
        if (horizontalOverlap <= 0) continue;

        var targetBottom = targetTop + sideHeight;
        var verticalOverlap = Math.min(row.bottom, targetBottom) - Math.max(row.top, targetTop);
        if (verticalOverlap > 0) {
          targetTop = row.bottom + rowGap;
        }
      }

      heroSide.style.setProperty('--hero-side-y', Math.max(0, Math.round(targetTop - sideRect.top)) + 'px');
    }

    tuneHeroSideOffset();
    window.setTimeout(tuneHeroSideOffset, 250);
    window.setTimeout(tuneHeroSideOffset, 900);
    window.setTimeout(tuneHeroSideOffset, 1200);
    window.addEventListener('resize', tuneHeroSideOffset);
    heroTitle.addEventListener('animationend', tuneHeroSideOffset);
    heroSide.addEventListener('animationend', tuneHeroSideOffset);
    if (document.fonts && document.fonts.ready) {
      document.fonts.ready.then(tuneHeroSideOffset).catch(function () {});
    }
    if ('ResizeObserver' in window && heroTitle) {
      var heroCopyObserver = new ResizeObserver(tuneHeroSideOffset);
      heroCopyObserver.observe(heroTitle);
    }

    heroSide.addEventListener('pointermove', function (event) {
      var rect = this.getBoundingClientRect();
      var rx = ((event.clientY - rect.top) / rect.height - 0.5) * -8;
      var ry = ((event.clientX - rect.left) / rect.width - 0.5) * 10;
      this.style.setProperty('--hero-rx', rx.toFixed(2) + 'deg');
      this.style.setProperty('--hero-ry', ry.toFixed(2) + 'deg');
    });
    heroSide.addEventListener('pointerleave', function () {
      this.style.removeProperty('--hero-rx');
      this.style.removeProperty('--hero-ry');
    });
  }

  var cards = document.querySelectorAll('.story-card');
  for (var i = 0; i < cards.length; i++) {
    cards[i].addEventListener('pointermove', function (event) {
      var rect = this.getBoundingClientRect();
      var x = ((event.clientX - rect.left) / rect.width) * 100;
      var y = ((event.clientY - rect.top) / rect.height) * 100;
      var rx = ((event.clientY - rect.top) / rect.height - 0.5) * -13;
      var ry = ((event.clientX - rect.left) / rect.width - 0.5) * 15;
      this.style.setProperty('--rx', rx.toFixed(2) + 'deg');
      this.style.setProperty('--ry', ry.toFixed(2) + 'deg');
    });
    cards[i].addEventListener('pointerleave', function () {
      this.style.removeProperty('--rx');
      this.style.removeProperty('--ry');
    });
  }

  function inferPlatform() {
    var ua = navigator.userAgent.toLowerCase();
    var platform = navigator.platform ? navigator.platform.toLowerCase() : '';
    var isArm = /arm|aarch64/.test(ua + ' ' + platform);
    if (ua.indexOf('win') !== -1 || platform.indexOf('win') !== -1) return { platform: 'windows', key: isArm ? 'windows-arm' : 'windows-x64' };
    if (ua.indexOf('linux') !== -1 || platform.indexOf('linux') !== -1) return { platform: 'linux', key: isArm ? 'linux-arm' : 'linux-x64' };
    return { platform: 'macos', key: 'macos-arm' };
  }

  var heroDownload = document.getElementById('hero-download-link');
  var detected = inferPlatform();
  if (heroDownload) {
    var key = detected.key;
    var attr = {
      'macos-arm': 'macosArm',
      'macos-intel': 'macosIntel',
      'windows-x64': 'windowsX64',
      'windows-arm': 'windowsArm',
      'linux-x64': 'linuxX64',
      'linux-arm': 'linuxArm'
    }[key];
    var href = attr ? heroDownload.dataset[attr] : heroDownload.dataset.macosArm;
    if (href) {
      heroDownload.href = href;
    }
    var labels = heroDownload.querySelectorAll('.hero-download-label');
    var zh = key.indexOf('windows') === 0 ? '下载 Windows' : key.indexOf('linux') === 0 ? '下载 Linux' : '下载 macOS';
    var en = key.indexOf('windows') === 0 ? 'Download Windows' : key.indexOf('linux') === 0 ? 'Download Linux' : 'Download macOS';
    for (var j = 0; j < labels.length; j++) {
      labels[j].textContent = labels[j].classList.contains('zh') ? zh : en;
    }
  }

  var homebrewCard = document.getElementById('homebrew-card');
  if (homebrewCard && detected.platform === 'macos') {
    homebrewCard.classList.add('is-visible');
    homebrewCard.setAttribute('aria-hidden', 'false');
  }

  var currentAlternate = document.querySelector('[data-download-key="' + detected.key + '"]');
  if (currentAlternate) currentAlternate.hidden = true;
})();
</script>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--header-height) + 2rem);
    padding-bottom: 5rem;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    background:
      linear-gradient(115deg, rgba(37, 99, 235, 0.12), transparent 34%),
      linear-gradient(245deg, rgba(20, 184, 166, 0.12), transparent 38%),
      linear-gradient(180deg, transparent 0%, var(--glass-wash) 100%);
  }

  .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255,255,255,0.32) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.24) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(180deg, black, transparent 62%);
    opacity: 0.32;
  }

  .liquid-plane {
    position: absolute;
    left: 50%;
    width: min(86vw, 1040px);
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    box-shadow: var(--glass-shadow-soft), inset 0 1px 0 var(--glass-highlight);
    backdrop-filter: blur(26px) saturate(180%);
    -webkit-backdrop-filter: blur(26px) saturate(180%);
    transform: translateX(-50%) rotate(-2deg);
  }

  .liquid-plane-1 {
    top: 8rem;
    height: 16rem;
    border-radius: 36px;
    opacity: 0.58;
  }

  .liquid-plane-2 {
    top: 16rem;
    height: 8rem;
    width: min(70vw, 780px);
    border-radius: 999px;
    opacity: 0.44;
    transform: translateX(-50%) rotate(2deg);
  }

  /* Hero entrance animation (CSS only, no observer needed) */
  .hero-anim {
    opacity: 0;
    animation: fade-in-up 0.7s ease forwards;
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 1;
    padding-top: 2.5rem;
    max-width: 1360px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.375rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    box-shadow: var(--glass-shadow-soft), inset 0 1px 0 var(--glass-highlight);
    backdrop-filter: blur(18px) saturate(180%);
    -webkit-backdrop-filter: blur(18px) saturate(180%);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: clamp(2.15rem, 3vw, 3.1rem);
    margin-left: clamp(0rem, 4vw, 4rem);
    transition:
      border-color 200ms ease,
      box-shadow 200ms ease,
      transform 240ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .hero-badge:hover {
    border-color: var(--color-accent);
    box-shadow: 0 0 16px rgba(59, 130, 246, 0.15);
    transform: translateY(-1px);
  }

  .hero-badge svg {
    color: var(--color-accent);
  }

  .hero-copy-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(360px, 480px);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
    min-width: 0;
  }

  .hero-copy-grid > * {
    min-width: 0;
  }

  .hero-title {
    margin: 0;
    color: var(--color-text);
    width: var(--hero-title-box-width, max-content);
    max-width: calc(100vw - 2rem);
    justify-self: start;
  }

  .title-stack {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(0.1rem, 1vw, 0.45rem);
    width: max-content;
    max-width: 100%;
  }

  .title-line {
    display: block;
    white-space: nowrap;
    font-size: clamp(4rem, 10.6vw, 8.4rem);
    font-weight: 880;
    line-height: 0.82;
    letter-spacing: 0;
  }

  .title-pair {
    display: flex;
    align-items: center;
    gap: clamp(0.7rem, 2vw, 1.4rem);
  }

  .title-connector {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: clamp(3.2rem, 6.8vw, 5.4rem);
    height: clamp(3.2rem, 6.8vw, 5.4rem);
    padding: 0 clamp(0.75rem, 2vw, 1.2rem);
    border-radius: 24px;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow-soft), inset 0 1px 0 var(--glass-highlight);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    color: var(--color-accent);
    font-size: clamp(1.9rem, 4.4vw, 4rem);
    font-weight: 820;
    line-height: 1;
    transform: rotate(-6deg);
  }

  .title-subline {
    display: block;
    white-space: nowrap;
    font-size: clamp(2.2rem, 7.3vw, 5.6rem);
    font-weight: 840;
    line-height: 0.95;
  }

  .hero-side {
    --hero-rx: 0deg;
    --hero-ry: 0deg;
    --hero-side-y: 0px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    position: relative;
    padding: 1.4rem;
    margin-block-start: var(--hero-side-y);
    margin-bottom: 0.6rem;
    border-radius: 24px;
    border: 1px solid var(--glass-border);
    background:
      var(--material-sheen),
