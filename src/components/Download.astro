---
const dockerRun = 'docker run -d --name presto -p 8080:8080 ghcr.io/presto-io/presto';
const dockerCompose = `services:
  presto:
    image: ghcr.io/presto-io/presto
    container_name: presto
    ports:
      - "8080:8080"
    restart: unless-stopped`;
---

<section class="self-host section" id="self-host">
  <div class="container">
    <details class="docker-utility animate-on-scroll">
      <summary>
        <span class="docker-summary-main">
          <span class="docker-kicker">Docker</span>
          <span>
            <span class="zh">自托管 Web 版</span>
            <span class="en">Self-hosted Web Version</span>
          </span>
        </span>
        <span class="docker-summary-note">
          <span class="zh">给团队、NAS 或服务器使用</span>
          <span class="en">For teams, NAS, or servers</span>
        </span>
      </summary>

      <div class="docker-utility-body">
        <div class="docker-code">
          <div class="docker-code-head">
            <span>docker run</span>
            <button class="copy-btn" data-copy={dockerRun}>
              <span class="zh">复制</span>
              <span class="en">Copy</span>
            </button>
          </div>
          <pre><code>{dockerRun}</code></pre>
        </div>

        <div class="docker-code docker-code--compose">
          <div class="docker-code-head">
            <span>compose.yml</span>
            <button class="copy-btn" data-copy={dockerCompose}>
              <span class="zh">复制</span>
              <span class="en">Copy</span>
            </button>
          </div>
          <pre><code>{dockerCompose}</code></pre>
        </div>
      </div>

      <p class="docker-hint">
        <span class="zh">启动后访问 <code>http://localhost:8080</code>。更多部署说明见 <a href="https://presto-doc.pages.dev" target="_blank" rel="noopener noreferrer">文档</a>。</span>
        <span class="en">Then visit <code>http://localhost:8080</code>. More deployment notes are in the <a href="https://presto-doc.pages.dev" target="_blank" rel="noopener noreferrer">docs</a>.</span>
      </p>
    </details>
  </div>
</section>

<script is:inline>
  document.querySelectorAll('.copy-btn').forEach(function (btn) {
    if (btn.dataset.copyBound === 'true') return;
    btn.dataset.copyBound = 'true';
    btn.addEventListener('click', function () {
      var text = this.getAttribute('data-copy');
      navigator.clipboard.writeText(text).then(function () {
        var originalNodes = Array.from(btn.childNodes).map(function(n) { return n.cloneNode(true); });
        btn.textContent = '✓';
        setTimeout(function () {
          btn.textContent = '';
          originalNodes.forEach(function(n) { btn.appendChild(n); });
        }, 1500);
      });
    });
  });
</script>

<style>
  .self-host {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .docker-utility {
    max-width: 900px;
    margin: 0 auto;
    border: 1px solid var(--glass-border);
    border-radius: 18px;
    background:
      var(--material-sheen),
      rgba(255, 255, 255, 0.28);
    box-shadow: var(--glass-shadow-soft), inset 0 1px 0 var(--glass-highlight);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    overflow: hidden;
  }

  .docker-utility summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    color: var(--color-text-secondary);
    cursor: pointer;
    list-style: none;
  }

  .docker-utility summary::-webkit-details-marker {
    display: none;
  }

  .docker-summary-main {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-width: 0;
    color: var(--color-text);
    font-size: 0.92rem;
    font-weight: 700;
  }

  .docker-kicker {
    padding: 0.22rem 0.55rem;
    border-radius: 999px;
    background: var(--glass-chip-bg);
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0;
  }

  .docker-summary-note {
    color: var(--color-text-muted);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .docker-utility-body {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 0.75rem;
    padding: 0 1rem 0.75rem;
  }

  .docker-code {
    min-width: 0;
    border-radius: 14px;
    border: 1px solid var(--glass-border);
    background: rgba(248, 250, 252, 0.7);
    overflow: hidden;
  }

  .docker-code--compose {
    background:
      linear-gradient(135deg, rgba(37, 99, 235, 0.06), rgba(20, 184, 166, 0.06)),
      rgba(248, 250, 252, 0.72);
  }

  .docker-code-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.62rem 0.7rem;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .docker-code pre {
    margin: 0;
    max-height: 152px;
    padding: 0.76rem;
    overflow: auto;
    color: var(--code-text);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.56;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .copy-btn {
    flex-shrink: 0;
    padding: 0.24rem 0.55rem;
    border-radius: 999px;
    border: 1px solid var(--glass-border);
    background: var(--glass-bg-strong);
    color: var(--color-accent);
    font-size: 0.7rem;
    font-weight: 800;
    transition:
      background-color 180ms ease,
      transform 220ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .copy-btn:hover {
    background: var(--glass-chip-bg);
    transform: translateY(-1px);
  }

  .docker-hint {
    margin: 0;
    padding: 0 1rem 0.95rem;
    color: var(--color-text-muted);
    font-size: 0.76rem;
  }

  .docker-hint code {
    color: var(--color-accent);
    font-family: var(--font-mono);
  }

  .docker-hint a {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (prefers-color-scheme: dark) {
    .docker-utility,
    .docker-code--compose {
      background:
        var(--interference-sheen),
        rgba(255, 255, 255, 0.055);
    }

    .docker-code {
      background: rgba(21, 21, 25, 0.72);
    }

    .docker-code-head {
      border-bottom-color: rgba(255, 255, 255, 0.08);
    }
  }

  @media (max-width: 760px) {
    .docker-utility summary {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }

    .docker-summary-note {
      white-space: normal;
    }

    .docker-utility-body {
      grid-template-columns: 1fr;
    }
  }
</style>
